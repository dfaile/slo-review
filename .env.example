# Copy to .env and fill in. Never commit .env.
# Used by implementation/agent.py and Agent Engine deploy.

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1

# Vertex AI Search / Agent Platform Search datastore IDs
SLO_REVIEW_DOCS_DATASTORE=slo-review-docs
SLO_REVIEW_SRE_CORPUS_DATASTORE=slo-review-sre-corpus

DEPLOYMENT_VERTICAL=horizontal
# DEPLOYMENT_VERTICAL=gxp | fedramp | pci

# Optional: register nobl9_catalog_lookup when both credentials are set.
# US default URL is https://app.nobl9.com; EU is https://app.nobl9.eu
# NOBL9_CLIENT_ID=
# NOBL9_CLIENT_SECRET=
# NOBL9_ORGANIZATION=
# NOBL9_URL=https://app.nobl9.com
# NOBL9_PROJECT=

# Required only for Spec Kit engine-mode reviews
# SLO_REVIEW_AGENT_ENGINE_RESOURCE=projects/PROJECT/locations/REGION/reasoningEngines/ENGINE_ID
